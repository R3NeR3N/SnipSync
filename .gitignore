# ==============================================================================
# SnipSync - .gitignore
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual Environment ---
venv/
env/
.env/
.venv/

# --- Distribution / Build ---
dist/
build/
*.egg-info/
*.egg
MANIFEST

# --- PyInstaller ---
*.spec.bak

# --- Unit test / coverage ---
.pytest_cache/
.coverage
htmlcov/
*.cover

# --- Jupyter Notebook ---
.ipynb_checkpoints

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Whisper model cache (large files) ---
# Models are auto-downloaded on first run; do not commit them
huggingface/
*.bin
*.pt

# --- Temporary / output files ---
*_temp_audio.wav
*_snipsynced.*
*.srt
tests/*.wav
tests/*.mp4
tests/*.mov
tests/*.avi
tests/*.mkv
