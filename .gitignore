# ==============================================================================
# SnipSync - .gitignore
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual Environment ---
venv/
env/
.env/
.venv/

# --- Distribution / Build ---
dist/
# build/ は PyInstaller の生成物置き場だが、設定（app.spec・フック）は追跡する。
# build/vendor/ には同梱用の auto-editor（scripts/fetch_auto_editor.py が取得）が入る。
build/*
!build/app.spec
!build/build_hooks/
*.egg-info/
*.egg
MANIFEST

# --- PyInstaller ---
*.spec.bak

# --- Unit test / coverage ---
.pytest_cache/
.coverage
htmlcov/
*.cover

# --- Jupyter Notebook ---
.ipynb_checkpoints

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Whisper model cache (large files) ---
# Models are auto-downloaded on first run; do not commit them
huggingface/
*.bin
*.pt

# --- Temporary / output files ---
*_temp_audio.wav
*_snipsynced.*
*.srt
tests/*.wav
tests/*.mp4
tests/*.mov
tests/*.avi
tests/*.mkv

# --- 作業用の文書（リモートへは載せない。手元には残る）---
# 公開するのは README* / LICENSE / CHANGELOG.md / DESIGN.md / ARCHITECTURE.md とコード。
/AGENTS.md
/CLAUDE.md
/CONTEXT.md
/MEMORY.md
/PITFALLS.md
/ROADMAP.md
/CONTRIBUTING.md
/docs/handoff/
/docs/superpowers/
